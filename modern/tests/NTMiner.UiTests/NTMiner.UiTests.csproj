<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><UseWPF>true</UseWPF></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\..\src\NTMiner.Desktop\NTMiner.Desktop.csproj" /></ItemGroup>
  <Target Name="CopyDesktopCompanions" AfterTargets="Build">
    <ItemGroup><Companion Include="..\..\src\NTMiner.Desktop\bin\$(Configuration)\$(TargetFramework)\*" /></ItemGroup>
    <Copy SourceFiles="@(Companion)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
