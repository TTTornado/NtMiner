<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NTMiner.Infrastructure\NTMiner.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\NTMiner.Agent\NTMiner.Agent.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NTMiner.FakeMiner\NTMiner.FakeMiner.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyTestProcesses" AfterTargets="Build">
    <ItemGroup>
      <!-- 递归复制：伙伴进程的依赖可能位于 runtimes\<rid>\lib\<tfm>\ 子目录。 -->
      <Companion Include="..\..\src\NTMiner.Agent\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <Companion Include="..\NTMiner.FakeMiner\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Companion)" DestinationFiles="@(Companion->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
