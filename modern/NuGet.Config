<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    包来源限定为工作区内的本地缓存目录，因此构建不依赖网络。
    缓存由 scripts/Build.ps1 -RestorePackages 一次性联网补齐。
    路径相对于工作区根目录（D:\重构NTMiner），与本仓库的 .tools 布局一致。
  -->
  <packageSources>
    <clear />
    <add key="workspace-cache" value="..\..\.tools\nuget-packages" />
  </packageSources>
</configuration>
