<Window x:Class="NTMiner.Modern.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NtMiner · PRL Preview" Width="1220" Height="840" MinWidth="1080" MinHeight="760"
 Background="#09111F" Foreground="#E8EEF7" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen"
 Loaded="WindowLoaded" Closing="WindowClosing">
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <StackPanel>
    <TextBlock Text="NT / MINER" FontSize="25" FontWeight="Bold" Foreground="#5EE4BD" />
    <TextBlock Text="PRL 工作台   /   本地优先 · 显式启动" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
   </StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1B2940" CornerRadius="12" Padding="12,6">
    <TextBlock Text="PREVIEW  0.2" FontSize="11" Foreground="#AFBED2" />
   </Border>
  </Grid>
  <Border Grid.Row="1" Background="#242417" BorderBrush="#665C27" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,18">
   <TextBlock x:Name="ModeBanner" Text="演示模式已开启。算力和份额均为模拟数据，不连接矿池，不使用显卡挖矿。" TextWrapping="Wrap" Foreground="#ECD68D" />
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border Background="#111E30" CornerRadius="10" Padding="22">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="挖矿配置" FontSize="19" FontWeight="SemiBold" />
      <TextBlock Text="Pearl / PRL · SRBMiner / BzMiner" Foreground="{StaticResource Muted}" Margin="0,6,0,10" />
      <CheckBox x:Name="DemoMode" Content="使用演示模式（推荐先体验）" IsChecked="True" Click="ModeChanged" />
      <TextBlock Text="内核 / 设备" Style="{StaticResource Caption}" />
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <ComboBox x:Name="MinerChoice" SelectedIndex="0" SelectionChanged="MinerSelectionChanged" Padding="7" Foreground="#112238">
        <ComboBoxItem Content="SRBMiner" /><ComboBoxItem Content="BzMiner" />
       </ComboBox>
       <ComboBox Grid.Column="2" x:Name="DeviceChoice" SelectedIndex="0" SelectionChanged="MinerSelectionChanged" Padding="7" Foreground="#112238">
        <ComboBoxItem Content="全部 GPU" /><ComboBoxItem Content="CPU" /><ComboBoxItem Content="仅核显" />
       </ComboBox>
      </Grid>
      <DockPanel Margin="0,12,0,0"><TextBlock Text="CPU 线程" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBox x:Name="CpuThreads" Text="1" Width="65" HorizontalAlignment="Left" IsEnabled="False" /><TextBlock x:Name="CpuHint" Text="先用 1 线程验证" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" /></DockPanel>
      <CheckBox x:Name="BenchmarkMode" Content="离线自测（无需钱包 / 矿池）" IsChecked="False" IsEnabled="False" Click="ModeChanged" />
      <StackPanel x:Name="RealFields" IsEnabled="False">
       <TextBlock Text="本地内核" Style="{StaticResource Caption}" />
       <DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="ChooseKernel" Margin="8,0,0,0" Padding="12,8" /><TextBox x:Name="KernelPath" ToolTip="选择与内核类型对应的官方 exe 文件" /></DockPanel>
       <StackPanel x:Name="WalletFields">
       <TextBlock Text="PRL 收款地址" Style="{StaticResource Caption}" />
       <TextBox x:Name="Wallet" ToolTip="只需 prl1 开头的收款地址，不要输入私钥或助记词" />
       <TextBlock Text="矿池地址" Style="{StaticResource Caption}" />
       <TextBox x:Name="Pool" ToolTip="stratum+tcp://矿池主机:端口；TLS 使用 stratum+ssl://" />
       <TextBlock Text="格式：stratum+tcp://主机:端口" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" />
       <TextBlock Text="矿机名" Style="{StaticResource Caption}" />
       <TextBox x:Name="Worker" Text="rig01" />
       </StackPanel>
      </StackPanel>
      <CheckBox x:Name="AutoRecover" Content="异常退出后自动恢复（最多 3 次）" IsChecked="True" Margin="0,20,0,10" />
      <TextBlock Text="内核开发费按其官方版本执行。首版不提供钱包替换、自动下载或超频功能。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
      <Button x:Name="SaveButton" Content="保存配置" Click="SaveConfiguration" HorizontalAlignment="Left" />
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Background="#111E30" CornerRadius="10" Padding="20">
     <Grid>
      <StackPanel>
       <TextBlock Text="任务状态" Foreground="{StaticResource Muted}" />
       <TextBlock x:Name="StateLabel" Text="正在连接后台…" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,5" />
       <TextBlock x:Name="ProcessLabel" Text="内核未启动" Foreground="{StaticResource Muted}" FontSize="12" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
       <Button x:Name="StartButton" Content="开始演示" Click="StartMining" Background="#5EE4BD" Foreground="#08261E" IsEnabled="False" Margin="0,0,8,0" />
       <Button x:Name="StopButton" Content="停止" Click="StopMining" IsEnabled="False" />
      </StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Border Background="#111E30" CornerRadius="8" Padding="16"><StackPanel><TextBlock x:Name="SpeedCaption" Text="内核报告算力" Foreground="{StaticResource Muted}" /><TextBlock x:Name="SpeedLabel" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
     <Border Grid.Column="2" Background="#111E30" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="接受 / 拒绝份额" Foreground="{StaticResource Muted}" /><TextBlock x:Name="SharesLabel" Text="0 / 0" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
     <Border Grid.Column="4" Background="#111E30" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="恢复次数" Foreground="{StaticResource Muted}" /><TextBlock x:Name="RestartsLabel" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="Feedback" Text="准备就绪后点击开始。程序不会自动挖矿。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,13,0,13" />
    <Border Grid.Row="3" Background="#0C1626" CornerRadius="10" Padding="16">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock Text="运行日志" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
      <TextBox Grid.Row="1" x:Name="LogOutput" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" BorderThickness="0" Padding="0" />
      <TextBlock Grid.Row="2" Text="份额由本机日志识别；最终有效算力与结算以矿池为准。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="ConnectionLabel" Text="仅本机控制 · 普通权限运行 · 关闭窗口将停止任务" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0" />
 </Grid>
</Window>
