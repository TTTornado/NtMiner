<Application x:Class="NTMiner.Modern.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9CAFC6" />
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="13" /></Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0C1626" /><Setter Property="Foreground" Value="#E8EEF7" />
   <Setter Property="BorderBrush" Value="#33465F" /><Setter Property="Padding" Value="10,8" />
   <Setter Property="CaretBrush" Value="#5EE4BD" /><Setter Property="FontSize" Value="13" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D4DEEA" /><Setter Property="Margin" Value="0,8" /></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,9" /><Setter Property="Background" Value="#23344D" />
   <Setter Property="Foreground" Value="#E8EEF7" /><Setter Property="BorderThickness" Value="0" />
   <Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="Margin" Value="0,14,0,6" /></Style>
 </Application.Resources>
</Application>
