<Window x:Class="NTMiner.Modern.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="RootLoaded">
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Padding="20,0,150,0">
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    <TextBlock Text="NtMiner" FontWeight="SemiBold" VerticalAlignment="Center" />
    <TextBlock Text="PRL 工作台" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
   </StackPanel>
  </Grid>
  <NavigationView Grid.Row="1" x:Name="Navigation" IsBackButtonVisible="Collapsed"
    IsSettingsVisible="False" PaneDisplayMode="Left" IsPaneToggleButtonVisible="True"
    OpenPaneLength="210" SelectionChanged="NavigationChanged">
   <NavigationView.PaneHeader>
    <StackPanel Margin="16,12,0,20" Spacing="5"><TextBlock Text="NT / MINER" FontSize="23" FontWeight="Bold" /><TextBlock Text="WinUI 3 · Preview 0.4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
   </NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="OverviewItem" Content="运行概览" Tag="overview" IsSelected="True"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="DashboardItem" Content="硬件仪表盘" Tag="dashboard"><NavigationViewItem.Icon><SymbolIcon Symbol="Calculator" /></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="ConfigurationItem" Content="挖矿配置" Tag="configuration"><NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="SettingsItem" Content="设置" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="LogsItem" Content="运行日志" Tag="logs"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <!-- 收起态侧边栏只有约 48px，这段说明文字没有空间，直接隐藏而不是被挤成竖排单字。 -->
    <StackPanel x:Name="PaneFooterText" Margin="16,16,12,20" Spacing="5"><TextBlock Text="仅本机控制" FontSize="12" /><TextBlock Text="关闭窗口将停止任务" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
   </NavigationView.PaneFooter>
   <Grid Padding="26,12,26,22" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
     <StackPanel Spacing="5"><TextBlock x:Name="PageHeading" Text="运行概览" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock x:Name="PageDescription" Text="查看任务、内核指标与运行状态。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
     <TextBlock Text="PEARL / PRL" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Grid>
    <InfoBar Grid.Row="1" x:Name="ModeBanner" IsOpen="True" IsClosable="False" Severity="Informational"
      Title="演示模式" Message="显示模拟算力和份额，不连接矿池，不运行真实挖矿。" />
    <Grid Grid.Row="2">
     <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
       <Border Style="{StaticResource Card}">
        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel Spacing="8">
          <TextBlock Text="任务状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="StateLabel" Text="正在连接后台…" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="ProcessLabel" Text="内核未启动" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="StartButton" Content="开始演示" Style="{StaticResource AccentButtonStyle}" Click="StartClicked" IsEnabled="False" />
          <Button x:Name="StopButton" Content="停止" Click="StopClicked" IsEnabled="False" />
         </StackPanel>
        </Grid>
       </Border>
       <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock x:Name="SpeedCaption" Text="内核报告算力" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SpeedLabel" Text="—" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="接受 / 拒绝份额" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SharesLabel" Text="0 / 0" FontSize="27" FontWeight="SemiBold" /></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="恢复次数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="RestartsLabel" Text="0" FontSize="27" FontWeight="SemiBold" /></StackPanel></Border>
       </Grid>
       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="12">
         <Grid>
          <TextBlock Text="显卡传感器" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="SensorSourceLabel" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         </Grid>
         <TextBlock x:Name="SensorEmptyHint" Text="尚未读取显卡传感器。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         <ItemsControl x:Name="GpuSensorList">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
             <StackPanel Spacing="6">
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Grid ColumnSpacing="18" RowSpacing="4">
               <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>
               <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="温度" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Temperature}" FontSize="12" MinWidth="44" Foreground="{Binding TemperatureBrush}" /></StackPanel>
               <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><TextBlock Text="风扇" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Fan}" FontSize="12" /></StackPanel>
               <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"><TextBlock Text="功耗" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Power}" FontSize="12" /></StackPanel>
               <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"><TextBlock Text="核心" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Clock}" FontSize="12" /></StackPanel>
               <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"><TextBlock Text="显存" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Memory}" FontSize="12" /></StackPanel>
              </Grid>
              <TextBlock Text="{Binding OverclockNote}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
             </StackPanel>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="14">
         <TextBlock Text="本次运行" FontSize="18" FontWeight="SemiBold" />
         <TextBlock x:Name="ConfigurationSummary" Text="SRBMiner · GPU · 演示模式" TextWrapping="Wrap" />
         <TextBlock x:Name="DeviceLabel" Text="内核尚未报告设备名称" TextWrapping="Wrap" />
         <TextBlock x:Name="RunEvidenceLabel" Text="任务运行后显示内核报告的设备和算力。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="修改配置" Click="ShowConfiguration" /><Button Content="查看运行日志" Click="ShowLogs" /><Button Content="查看硬件" Click="ShowDashboard" /></StackPanel>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
     <ScrollViewer x:Name="DashboardPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" VerticalAlignment="Top">
       <Border Style="{StaticResource Card}">
        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel Spacing="6">
          <TextBlock Text="本机硬件配置" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="HardwareSummary" Text="尚未检测。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         </StackPanel>
         <Button Grid.Column="1" x:Name="RescanButton" Content="重新检测" VerticalAlignment="Center" Click="RescanHardware" />
        </Grid>
       </Border>
       <InfoBar x:Name="HardwareProblems" IsOpen="False" IsClosable="False" Severity="Warning" Title="部分硬件信息不可用" />
       <InfoBar x:Name="HardwareAdvice" IsOpen="False" IsClosable="False" Severity="Informational" Title="硬件与挖矿模式" />
       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="0">
         <TextBlock Text="点击任意一行查看详细信息" FontSize="12" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         <ListView x:Name="HardwareList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="HardwareRowClicked" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Background="Transparent" Padding="0" Margin="-12,0">
          <ListView.ItemContainerStyle>
           <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
           </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
           <DataTemplate>
            <Grid ColumnSpacing="14" Padding="0,2" VerticalAlignment="Center">
             <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
             <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <FontIcon Glyph="{Binding Glyph}" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
             </StackPanel>
             <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{Binding IsMissing, Converter={StaticResource MissingBrush}}" />
             <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
           </DataTemplate>
          </ListView.ItemTemplate>
         </ListView>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
     <ScrollViewer x:Name="ConfigurationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" VerticalAlignment="Top">
       <InfoBar x:Name="RestartHint" IsOpen="False" IsClosable="False" Severity="Warning" Title="改动需要重启任务才会生效"
         Message="当前任务仍在按旧参数运行。停止后重新启动即可应用新配置。" />

       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="14">
         <TextBlock Text="挖矿内核" FontSize="18" FontWeight="SemiBold" />
         <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ComboBox x:Name="ImportedKernelChoice" Header="已导入内核" PlaceholderText="尚未导入内核" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" SelectionChanged="ImportedKernelSelected" />
          <Button Grid.Column="1" x:Name="DeleteKernelButton" Content="删除" VerticalAlignment="Bottom" Click="DeleteKernelClicked" />
          <Button Grid.Column="2" x:Name="ImportKernelButton" Content="导入 BzMiner exe" VerticalAlignment="Bottom" Click="ChooseKernel" />
          <ComboBox x:Name="MinerChoice" Visibility="Collapsed" SelectedIndex="1" SelectionChanged="MinerSelectionChanged"><ComboBoxItem Content="SRBMiner" /><ComboBoxItem Content="BzMiner" /></ComboBox>
         </Grid>
         <ComboBox x:Name="DeviceChoice" Header="设备" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="MinerSelectionChanged"><ComboBoxItem Content="全部 GPU" /><ComboBoxItem Content="CPU" /><ComboBoxItem Content="仅核显" /></ComboBox>
         <TextBox x:Name="KernelPath" Visibility="Collapsed" IsReadOnly="True" TextChanged="FieldChanged" />
         <StackPanel x:Name="CpuOptions" Visibility="Collapsed" Spacing="12">
          <NumberBox x:Name="CpuThreads" Header="CPU 线程数" Minimum="1" Value="1" SpinButtonPlacementMode="Inline" SmallChange="1" Width="220" HorizontalAlignment="Left" ValueChanged="NumberChanged" />
          <TextBlock x:Name="CpuHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         </StackPanel>
         <TextBlock x:Name="DeviceHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         <TextBlock Text="目前仅适配 BzMiner。列表只显示名称和版本。导入会复制 exe、配套 DLL 及 plugins/kernels 目录到软件安装目录，可随时删除；不执行内核，也不导入原矿池配置。" FontSize="12" TextWrapping="Wrap" />
         <TextBox x:Name="AlgorithmText" Header="算法（留空使用 PRL 默认算法）" MaxLength="64" TextChanged="FieldChanged" />
         <Button Content="读取 BzMiner 算法列表" Click="ReadAlgorithms" />
         <ComboBox x:Name="AlgorithmChoice" Header="内核报告的可用算法" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="AlgorithmSelected" />
         <TextBlock x:Name="AlgorithmHint" Text="矿池流程仅支持 PRL；其他算法仅用于离线自测。读取列表需要执行所选内核，不会启动挖矿。" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
       </Border>

       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="14">
         <TextBlock Text="收款账户" FontSize="18" FontWeight="SemiBold" />
         <TextBox x:Name="Wallet" Header="钱包地址" PlaceholderText="prl1…（不要输入私钥或助记词）" TextChanged="FieldChanged" />
         <ComboBox x:Name="WalletChoice" Header="已保存的钱包" HorizontalAlignment="Stretch" SelectionChanged="WalletSelected" />
         <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="保存当前地址" Click="AddWallet" /><Button Content="移除所选地址" Click="RemoveWallet" /></StackPanel>
         <StackPanel x:Name="WalletFields" Spacing="14">
          <TextBox x:Name="Pool" Header="矿池地址" PlaceholderText="stratum+tcp://主机:端口" TextChanged="FieldChanged" />
          <TextBox x:Name="BackupPoolText" Header="备用矿池（每行一个，按顺序尝试）" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="8192" MinHeight="68" TextChanged="FieldChanged" />
          <TextBox x:Name="Worker" Header="矿机名" Text="rig01" TextChanged="FieldChanged" />
         </StackPanel>
         <CheckBox x:Name="BenchmarkMode" Content="离线自测：无需钱包或矿池，不产生收益" IsChecked="False" Click="ModeChanged" />
         <CheckBox x:Name="AutoRecover" Content="内核异常退出后自动恢复，最多 3 次" IsChecked="True" Click="ModeChanged" />
         <TextBlock Text="请自行核对内核来源与完整收款地址。开发费按实际内核版本执行。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
       </Border>

       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="12">
         <TextBlock Text="内核参数" FontSize="18" FontWeight="SemiBold" />
         <TextBlock x:Name="SwitchHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         <StackPanel x:Name="CommonSwitchPanel" Spacing="2" />
         <Expander x:Name="AdvancedSwitches" Header="高级设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel x:Name="AdvancedSwitchPanel" Spacing="2" Padding="0,8,0,0" />
         </Expander>
        </StackPanel>
       </Border>

       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="10">
         <Grid><TextBlock Text="原始命令行参数" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="预览" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
         <TextBox x:Name="CommandLinePreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                  MinHeight="72" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
         <TextBlock x:Name="CommandLineNote" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
       </Border>

       <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="返回运行概览" Click="ShowOverview" />
        <TextBlock x:Name="AutoSaveState" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
     <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" VerticalAlignment="Top" MaxWidth="720" HorizontalAlignment="Left">
       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="14">
         <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" />
         <ComboBox x:Name="ThemeChoice" Header="主题" SelectedIndex="0" Width="240" HorizontalAlignment="Left" SelectionChanged="ThemeChanged"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox>
         <TextBlock Text="主题选择保存在本机配置，下次打开窗口时沿用。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="14">
         <TextBlock Text="运行" FontSize="18" FontWeight="SemiBold" />
         <ToggleSwitch x:Name="DemoMode" Header="演示模式" OnContent="模拟数据，不使用真实内核" OffContent="使用本机内核" IsOn="True" Toggled="ModeChanged" />
         <TextBlock Text="演示模式使用内置模拟内核，显示模拟算力与份额，不连接矿池、不产生收益，也不会执行你选择的内核文件。"
                    FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
     <Grid x:Name="LogsPanel" Visibility="Collapsed" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid><TextBlock Text="当前会话日志" FontSize="18" FontWeight="SemiBold" /><Button Content="导出日志" Click="ExportLogs" HorizontalAlignment="Right" /></Grid>
      <TextBox Grid.Row="1" x:Name="LogOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
      <TextBlock Grid.Row="2" Text="仅展示本机日志。离线自测不统计矿池份额；没有新算力时显示“—”。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
     </Grid>
    </Grid>
    <InfoBar Grid.Row="3" x:Name="FeedbackBar" IsOpen="True" IsClosable="False" Severity="Informational" Message="准备就绪后点击开始。程序不会自动挖矿。" />
   </Grid>
  </NavigationView>
 </Grid>
</Window>
