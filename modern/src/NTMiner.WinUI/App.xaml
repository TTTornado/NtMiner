<Application x:Class="NTMiner.Modern.WinUI.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:NTMiner.Modern.WinUI">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <local:MissingBrushConverter x:Key="MissingBrush" />
   <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="20" />
   </Style>
   <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,14,0,6" /><Setter Property="FontSize" Value="13" />
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
