<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>NTMiner.Modern.WinUI</RootNamespace>
    <Version>0.4.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)..\..\WinUI.NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <ProjectReference Include="..\NTMiner.Infrastructure\NTMiner.Infrastructure.csproj" />
    <ProjectReference Include="..\NTMiner.Agent\NTMiner.Agent.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\tests\NTMiner.FakeMiner\NTMiner.FakeMiner.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyCompanionApplications" AfterTargets="Build">
    <ItemGroup>
      <Companion Include="..\NTMiner.Agent\bin\$(Platform)\$(Configuration)\net10.0-windows\*" />
      <Companion Include="..\..\tests\NTMiner.FakeMiner\bin\$(Platform)\$(Configuration)\net10.0-windows\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Companion)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
